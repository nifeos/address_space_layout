Falsifies `address_space_layout::verification::the_bands_are_listed_in_virtual_address_order`.

The defect: `BANDS` lists `HEAP` before `RUNTIME_WINDOWS`. Every address still lies in exactly
one band, so the membership harness stays green; only the order is wrong. The `const` tiling
assert in `lib.rs` would stop the build first, so the patch deletes it as well.

Expected to fail: the harness's `assert!(band_index(low) <= band_index(high))`.

diff --git a/src/lib.rs b/src/lib.rs
--- a/src/lib.rs
+++ b/src/lib.rs
@@ -193,8 +193,8 @@
 pub const BANDS: &[(&str, Band)] = &[
     ("NULL_GUARD", NULL_GUARD),
     ("PAIR_PAGES", PAIR_PAGES),
-    ("RUNTIME_WINDOWS", RUNTIME_WINDOWS),
     ("HEAP", HEAP),
+    ("RUNTIME_WINDOWS", RUNTIME_WINDOWS),
     ("SERVICE_WINDOWS", SERVICE_WINDOWS),
     ("IMAGE", IMAGE),
     ("STACK", STACK),
@@ -377,10 +377,6 @@
     let mut i = 0;
     while i < BANDS.len() {
         let band = BANDS[i].1;
-        assert!(
-            band.start == at,
-            "a band does not start where the band below it ends"
-        );
         assert!(band.start < band.end, "a band is empty");
         assert!(
             band.start.is_multiple_of(PAGE_BYTES),
